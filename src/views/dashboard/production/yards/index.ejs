<div class="container-fluid">
  <!-- Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h3 class="fw-bold mb-1" style="color: #1F2937;">
        ساحات الإنتاج
        <i class="fa-solid fa-square-parking text-muted fs-5 ms-2"></i>
      </h3>
      <p class="text-muted mb-0 small">
        إدارة وتوزيع ساحات ومساحات الإنتاج وتحديد سعتها الاستيعابية من الغرف
      </p>
    </div>
    <div class="d-flex gap-2">
      <% if (canCreate) { %>
        <a href="/production/yards/create" class="btn btn-primary d-inline-flex align-items-center gap-2" style="background-color: #0984E3; border-color: #0984E3;">
          <i class="fa-solid fa-plus"></i>
          <span>إنشاء ساحة جديدة</span>
        </a>
      <% } %>
    </div>
  </div>

  <!-- Search & Filter Card -->
  <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
    <div class="card-body p-3">
      <form method="GET" action="/production/yards" class="row g-2 align-items-center">
        <div class="col-md-5 col-lg-4">
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
            <input type="text" name="search" class="form-control border-start-0 bg-light" placeholder="بحث بالاسم أو الرمز..." value="<%= search %>">
          </div>
        </div>

        <div class="col-md-4 col-lg-3">
          <select name="departmentId" class="form-select bg-light">
            <option value="">-- جميع الأقسام --</option>
            <% if (departments && departments.length > 0) { %>
              <% departments.forEach(function(d) { %>
                <option value="<%= d.id %>" <%= selectedDepartmentId === d.id ? 'selected' : '' %>>
                  <%= d.name %> (<%= d.code %>)
                </option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <div class="col-auto">
          <button type="submit" class="btn btn-outline-secondary">تطبيق الفلتر</button>
          <% if (search || selectedDepartmentId) { %>
            <a href="/production/yards" class="btn btn-link text-muted text-decoration-none">إلغاء الفلتر</a>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <!-- Yards Table Card -->
  <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light text-muted" style="font-size: 0.85rem;">
          <tr>
            <th class="ps-4 py-3">اسم الساحة</th>
            <th class="py-3">الرمز التقني</th>
            <th class="py-3">القسم التابع</th>
            <th class="py-3 text-center">السعة الاستيعابية</th>
            <th class="py-3 text-center">الحالة</th>
            <th class="py-3">تاريخ الإنشاء</th>
            <th class="py-3 text-center px-4">الإجراءات</th>
          </tr>
        </thead>
        <tbody>
          <% if (yards && yards.length > 0) { %>
            <% yards.forEach(function(yard) { %>
              <tr>
                <td class="ps-4">
                  <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex justify-content-center align-items-center text-white fw-bold" style="width: 40px; height: 40px; background-color: #00CEC9; font-size: 1rem;">
                      <%= yard.name ? yard.name.charAt(0) : 'Y' %>
                    </div>
                    <div>
                      <div class="fw-bold text-dark"><%= yard.name %></div>
                      <% if (yard.description) { %>
                        <div class="text-muted small text-truncate" style="max-width: 220px;"><%= yard.description %></div>
                      <% } %>
                    </div>
                  </div>
                </td>
                <td>
                  <code class="bg-light text-dark px-2 py-1 rounded border"><%= yard.code %></code>
                </td>
                <td>
                  <span class="badge bg-primary-subtle text-primary px-2.5 py-1.5 rounded-pill font-monospace">
                    <i class="fa-solid fa-building-user me-1"></i> <%= yard.departmentName || 'غير محدد' %>
                  </span>
                </td>
                <td class="text-center">
                  <span class="badge bg-info-subtle text-info-emphasis px-3 py-1.5 rounded-pill fw-bold" style="font-size: 0.9rem;">
                    <%= yard.capacity %> <small class="fw-normal">غرفة</small>
                  </span>
                </td>
                <td class="text-center">
                  <% if (yard.isActive) { %>
                    <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill">
                      <i class="fa-solid fa-circle-check me-1"></i> نشط
                    </span>
                  <% } else { %>
                    <span class="badge bg-danger-subtle text-danger px-3 py-1 rounded-pill">
                      <i class="fa-solid fa-circle-xmark me-1"></i> معطل
                    </span>
                  <% } %>
                </td>
                <td class="text-muted small">
                  <%= new Date(yard.createdAt).toLocaleDateString('ar-SA', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                </td>
                <td class="py-3 text-center px-4">
                  <div class="d-inline-flex gap-1">
                    <a
                      href="/production/yards/<%= yard.id %>"
                      class="btn btn-sm btn-outline-info"
                      title="عرض تفاصيل الساحة والقوالب"
                    >
                      <i class="fa-solid fa-eye"></i>
                    </a>
                    <% if (yard.canUpdate) { %>
                      <a
                        href="/production/yards/<%= yard.id %>/edit"
                        class="btn btn-sm btn-outline-primary"
                        title="تعديل"
                      >
                        <i class="fa-solid fa-pen-to-square"></i>
                      </a>
                      <% if (yard.isActive) { %>
                        <button
                          type="button"
                          class="btn btn-sm btn-outline-warning"
                          title="تعطيل الساحة"
                          data-action="toggle-yard-status"
                          data-yard-id="<%= yard.id %>"
                          data-yard-name="<%= yard.name %>"
                          data-new-status="false"
                        >
                          <i class="fa-solid fa-ban"></i>
                        </button>
                      <% } else { %>
                        <button
                          type="button"
                          class="btn btn-sm btn-outline-success"
                          title="تفعيل الساحة"
                          data-action="toggle-yard-status"
                          data-yard-id="<%= yard.id %>"
                          data-yard-name="<%= yard.name %>"
                          data-new-status="true"
                        >
                          <i class="fa-solid fa-check"></i>
                        </button>
                      <% } %>
                    <% } %>

                    <% if (yard.canDelete) { %>
                      <button
                        type="button"
                        class="btn btn-sm btn-outline-danger"
                        title="أرشفة الساحة"
                        data-action="delete-yard"
                        data-yard-id="<%= yard.id %>"
                        data-yard-name="<%= yard.name %>"
                      >
                        <i class="fa-solid fa-trash-can"></i>
                      </button>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-5 text-muted">
                <i class="fa-solid fa-square-parking fs-1 text-secondary mb-3 d-block"></i>
                <p class="mb-0 fw-bold">لا توجد ساحات إنتاج مسجلة حالياً</p>
                <% if (search || selectedDepartmentId) { %>
                  <small class="text-muted">جرب البحث بكلمات أخرى أو تغيير الفلتر</small>
                <% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (pagination && pagination.totalPages > 1) { %>
      <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center py-3 px-4">
        <div class="text-muted small">
          إجمالي السجلات: <span class="fw-bold"><%= pagination.total %></span>
        </div>
        <nav>
          <ul class="pagination pagination-sm mb-0">
            <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
              <a class="page-link" href="?page=<%= pagination.page - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= selectedDepartmentId ? '&departmentId=' + encodeURIComponent(selectedDepartmentId) : '' %>">السابق</a>
            </li>
            <% for (let p = 1; p <= pagination.totalPages; p++) { %>
              <li class="page-item <%= pagination.page === p ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= p %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= selectedDepartmentId ? '&departmentId=' + encodeURIComponent(selectedDepartmentId) : '' %>"><%= p %></a>
              </li>
            <% } %>
            <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
              <a class="page-link" href="?page=<%= pagination.page + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= selectedDepartmentId ? '&departmentId=' + encodeURIComponent(selectedDepartmentId) : '' %>">التالي</a>
            </li>
          </ul>
        </nav>
      </div>
    <% } %>
  </div>
</div>

<script src="/js/production-yards.js"></script>
