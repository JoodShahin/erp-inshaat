      </div>
      <form id="addTaskForm" class="needs-validation" novalidate>
        <input type="hidden" id="addTaskPatternId">
        <input type="hidden" id="addTaskOptionId">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label for="newOptionTaskName" class="form-label fw-bold small text-dark">اسم المهمة <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="newOptionTaskName" required placeholder="مثال: تجهيز الحديد، تركيب التسليح">
            <div class="invalid-feedback">يرجى إدخال اسم المهمة.</div>
          </div>

          <div class="mb-3">
            <label for="newOptionTaskDeptId" class="form-label fw-bold small text-dark">القسم التشغيلي المسؤول <span class="text-danger">*</span></label>
            <select class="form-select" id="newOptionTaskDeptId" required>
              <option value="">-- اختر القسم الإنتاجي --</option>
              <% if (typeof departments !== 'undefined' && departments) { %>
                <% departments.forEach(function(dept) { %>
                  <option value="<%= dept.id %>"><%= dept.name %> (<%= dept.code %>)</option>
                <% }); %>
              <% } %>
            </select>
            <div class="invalid-feedback">يرجى اختيار القسم التشغيلي.</div>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-7">
              <label for="newOptionTaskDuration" class="form-label fw-bold small text-dark">المدة التقديرية</label>
              <div class="input-group">
                <input type="number" class="form-control" id="newOptionTaskDuration" min="1" step="1" placeholder="المدة">
                <select class="form-select" id="newOptionTaskDurationUnit" style="max-width: 105px;">
                  <option value="MINUTES" selected>دقائق</option>
                  <option value="HOURS">ساعات</option>
                  <option value="DAYS">أيام</option>
                </select>
              </div>
            </div>
            <div class="col-5">
              <label for="newOptionTaskCost" class="form-label fw-bold small text-dark">التكلفة التقديرية (اختياري)</label>
              <input type="number" class="form-control" id="newOptionTaskCost" min="0" step="0.01" placeholder="0.00">
            </div>
          </div>

          <div class="mb-2">
            <label for="newOptionTaskDescription" class="form-label fw-bold small text-dark">الوصف وملاحظات التنفيذ</label>
            <textarea class="form-control" id="newOptionTaskDescription" rows="2" placeholder="تعليمات تشغيلية محددة لهذه المهمة..."></textarea>
          </div>
        </div>
        <div class="modal-footer border-top bg-light">
          <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">إلغاء</button>
          <button type="submit" id="btnSubmitAddTask" class="btn production-theme-btn px-4">إضافة المهمة</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ======================================================== -->
<!-- 10. TASK MODAL (Centered Unified Task Workspace Dialog)  -->
<!-- ======================================================== -->
<div class="modal fade stage-modal" id="taskModal" tabindex="-1" aria-labelledby="taskModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header py-3 px-4 bg-white border-bottom">
        <div class="d-flex align-items-center gap-3 flex-grow-1 overflow-hidden">
          <span class="badge bg-primary fs-6 py-2 px-3 rounded-pill shadow-sm" id="taskModalOrderBadge">#1</span>
          <div>
            <h5 class="modal-title fw-bold text-dark text-truncate mb-1" id="taskModalTitle">تفاصيل المهمة</h5>
            <span class="badge bg-secondary-subtle text-secondary small px-2 py-1" id="taskModalDeptBadge">القسم</span>
          </div>
        </div>
        <button type="button" class="btn-close ms-2" data-bs-dismiss="modal" aria-label="إغلاق"></button>
      </div>

      <!-- Task Modal Tabs Header -->
      <ul class="nav nav-tabs stage-modal-tabs px-4 pt-2 bg-light border-bottom" id="taskModalTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" id="tab-task-info" data-bs-toggle="tab" data-bs-target="#pane-task-info" type="button" role="tab">
            <i class="fa-solid fa-sliders me-1"></i> معلومات المهمة
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="tab-task-materials" data-bs-toggle="tab" data-bs-target="#pane-task-materials" type="button" role="tab">
            <i class="fa-solid fa-boxes-stacked me-1"></i> المواد المخططة <span class="badge bg-primary-subtle text-primary ms-1" id="taskTabMaterialsBadge">0</span>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="tab-task-attachments" data-bs-toggle="tab" data-bs-target="#pane-task-attachments" type="button" role="tab">
            <i class="fa-solid fa-paperclip me-1"></i> الوثائق المرجعية <span class="badge bg-info-subtle text-info ms-1" id="taskTabAttachmentsBadge">0</span>
          </button>
        </li>
      </ul>

      <!-- Task Modal Body -->
      <div class="modal-body p-4">
        <div class="tab-content">
          <!-- 1. TAB: Task Info -->
          <div class="tab-pane fade show active" id="pane-task-info" role="tabpanel">
            <form id="taskInfoForm" class="needs-validation" novalidate>
              <div class="mb-3">
                <label for="drawerTaskName" class="form-label fw-bold small text-dark">اسم المهمة <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="drawerTaskName" required>
                <div class="invalid-feedback">يرجى إدخال اسم المهمة.</div>
              </div>

              <div class="mb-3">
                <label for="drawerTaskDeptId" class="form-label fw-bold small text-dark">القسم التشغيلي المسؤول <span class="text-danger">*</span></label>
                <select class="form-select" id="drawerTaskDeptId" required>
                  <option value="">-- اختر القسم الإنتاجي --</option>
                  <% if (typeof departments !== 'undefined' && departments) { %>
                    <% departments.forEach(function(dept) { %>
                      <option value="<%= dept.id %>"><%= dept.name %> (<%= dept.code %>)</option>
                    <% }); %>
                  <% } %>
                </select>
                <div class="invalid-feedback">يرجى اختيار القسم التشغيلي.</div>
              </div>

              <div class="row g-2 mb-3">
                <div class="col-7">
                  <label for="drawerTaskDuration" class="form-label fw-bold small text-dark">المدة التقديرية</label>
                  <div class="input-group">
                    <input type="number" class="form-control" id="drawerTaskDuration" min="1" step="1" placeholder="المدة">
                    <select class="form-select" id="drawerTaskDurationUnit" style="max-width: 105px;">
                      <option value="MINUTES" selected>دقائق</option>
                      <option value="HOURS">ساعات</option>
                      <option value="DAYS">أيام</option>
                    </select>
                  </div>
                </div>
                <div class="col-5">
                  <label for="drawerTaskCost" class="form-label fw-bold small text-dark">التكلفة التقديرية (اختياري)</label>
                  <input type="number" class="form-control" id="drawerTaskCost" min="0" step="0.01" placeholder="0.00">
                </div>
              </div>

              <div class="mb-4">
                <label for="drawerTaskDescription" class="form-label fw-bold small text-dark">الوصف وملاحظات التنفيذ</label>
                <textarea class="form-control" id="drawerTaskDescription" rows="3" placeholder="ملاحظات تفصيلية لتنفيذ هذه المهمة..."></textarea>
              </div>

              <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                  <button type="button" class="btn btn-outline-danger btn-sm" id="btnArchiveTaskModal">
                    <i class="fa-solid fa-trash-can me-1"></i> أرشفة المهمة
                  </button>
                  <button type="submit" id="btnSaveTaskInfo" class="btn production-theme-btn px-4">
                    <i class="fa-solid fa-floppy-disk me-1"></i> حفظ التعديلات
                  </button>
                </div>
              <% } %>
            </form>
          </div>

          <!-- 2. TAB: Task Materials -->
          <div class="tab-pane fade" id="pane-task-materials" role="tabpanel">
            <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
              <!-- Add Material Card -->
              <div class="card border mb-4 bg-light bg-opacity-50" style="border-radius: 10px;">
                <div class="card-body p-3">
                  <h6 class="fw-bold mb-2 small text-dark"><i class="fa-solid fa-plus-circle me-1 text-primary"></i> إضافة مادة مخططة من الكتالوج</h6>
                  
                  <!-- Product Search & Picker -->
                  <div class="mb-3 position-relative">
                    <label for="taskMaterialSearchInput" class="form-label small fw-bold text-dark">البحث في كتالوج المنتجات:</label>
                    <div class="input-group input-group-sm">
                      <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                      <input type="text" class="form-control" id="taskMaterialSearchInput" placeholder="ابحث باسم المادة أو الكود...">
                    </div>
                    
                    <!-- Search Results Box -->
                    <div id="taskCatalogSearchResults" class="catalog-search-results-box d-none mt-1 shadow-sm">
                      <div id="taskCatalogSearchResultsList"></div>
                      <div class="p-2 text-center border-top bg-light d-none" id="taskCatalogLoadMoreContainer">
                        <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" id="btnTaskCatalogLoadMore">
                          <i class="fa-solid fa-circle-chevron-down me-1"></i> تحميل المزيد من النتائج
                        </button>
                      </div>
                    </div>

                    <!-- Selected Product Badge -->
                    <div id="taskSelectedProductContainer" class="d-none mt-2 p-2 bg-white border rounded d-flex justify-content-between align-items-center">
                      <div>
                        <span class="badge bg-primary font-monospace me-1" id="taskSelectedProductCode">CODE</span>
                        <strong class="text-dark small" id="taskSelectedProductName">اسم المنتج</strong>
                      </div>
                      <button type="button" class="btn btn-sm btn-link text-danger p-0" id="btnTaskDeselectProduct">إلغاء الاختيار</button>
                    </div>
                  </div>

                  <!-- Unit & Quantity Inputs -->
                  <form id="taskAddMaterialForm" class="row g-2 align-items-end needs-validation" novalidate>
                    <div class="col-7">
                      <label for="taskMaterialUnitSelect" class="form-label fw-bold small text-dark">وحدة القياس <span class="text-danger">*</span></label>
                      <select class="form-select form-select-sm" id="taskMaterialUnitSelect" required disabled>
                        <option value="">-- اختر الوحدة --</option>
                      </select>
                      <div class="invalid-feedback">يرجى اختيار الوحدة.</div>
                    </div>

                    <div class="col-5">
                      <label for="taskMaterialQuantityInput" class="form-label fw-bold small text-dark">الكمية المخططة <span class="text-danger">*</span></label>
                      <input type="number" class="form-control form-control-sm" id="taskMaterialQuantityInput" min="0.000001" step="any" placeholder="الكمية" required disabled>
                      <div class="invalid-feedback">أدخل كمية > 0</div>
                    </div>

                    <div class="col-12 text-end mt-2">
                      <button type="submit" id="btnSubmitTaskMaterial" class="btn btn-sm production-theme-btn px-4" disabled>
                        <i class="fa-solid fa-plus me-1"></i> إضافة المادة للمهمة
                      </button>
                    </div>
                  </form>
                </div>
              </div>
            <% } %>

            <!-- Existing Materials Table -->
            <h6 class="fw-bold mb-2 small text-dark"><i class="fa-solid fa-list me-1 text-muted"></i> المواد المحددة لهذه المهمة</h6>
            <div class="table-responsive border rounded-3 mb-2">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr class="small text-muted">
                    <th style="min-width: 150px;">اسم المادة</th>
                    <th style="min-width: 100px;">الكود</th>
                    <th style="min-width: 110px;">الوحدة</th>
                    <th style="min-width: 90px;" class="text-center">الكمية المخططة</th>
                    <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
                      <th style="width: 70px;" class="text-center">إجراء</th>
                    <% } %>
                  </tr>
                </thead>
                <tbody id="taskMaterialsTableBody"></tbody>
              </table>
            </div>
          </div>

          <!-- 3. TAB: Task Attachments -->
          <div class="tab-pane fade" id="pane-task-attachments" role="tabpanel">
            <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
              <!-- Upload Attachment Card -->
              <div class="card border mb-4 bg-light bg-opacity-50" style="border-radius: 10px;">
                <div class="card-body p-3">
                  <h6 class="fw-bold mb-2 small text-dark"><i class="fa-solid fa-cloud-arrow-up me-1 text-primary"></i> إرفاق وثيقة أو مخطط مرجعي جديد</h6>
                  <form id="taskUploadAttachmentForm" class="needs-validation" novalidate>
                    <div class="mb-2">
                      <label for="taskAttachmentFileInput" class="form-label small fw-bold text-dark">الملف <span class="text-danger">*</span></label>
                      <input type="file" class="form-control form-control-sm" id="taskAttachmentFileInput" accept=".pdf,.png,.jpg,.jpeg,.webp" required>
                      <div class="invalid-feedback">يرجى اختيار ملف صالح (PDF أو صورة).</div>
                    </div>
                    <div class="mb-3">
                      <label for="taskAttachmentDescInput" class="form-label small fw-bold text-dark">وصف الوثيقة (اختياري)</label>
                      <input type="text" class="form-control form-control-sm" id="taskAttachmentDescInput" maxlength="500" placeholder="مثال: مخطط التسليح، تعليمات التنفيذ">
                    </div>
                    <div class="d-flex justify-content-end">
                      <button type="submit" id="btnUploadTaskAttachment" class="btn btn-sm production-theme-btn px-4 d-inline-flex align-items-center gap-2">
                        <span class="spinner-border spinner-border-sm d-none" id="taskUploadSpinner" role="status" aria-hidden="true"></span>
                        <i class="fa-solid fa-upload"></i>
                        <span>رفع الوثيقة</span>
                      </button>
                    </div>
                  </form>
                </div>
              </div>
            <% } %>

            <!-- Existing Attachments List -->
            <h6 class="fw-bold mb-2 small text-dark"><i class="fa-solid fa-paperclip me-1 text-muted"></i> الوثائق المرفقة حالياً</h6>
            <div id="taskAttachmentsListContainer" class="d-flex flex-column gap-2">
              <!-- Dynamically populated via client JS -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Safe JSON Configuration for Client Script (XSS Protected) -->
<script type="application/json" id="productionTemplateConfigData">
  <%- safeJsonStringify({
    templateId: template.id,
    templateName: template.name,
    templateCode: template.code,
    templateReferenceNumber: template.referenceNumber || null,
    templateDescription: template.description || null,
    templateIsActive: Boolean(template.isActive),
    canUpdateTemplate: typeof canUpdateTemplate !== 'undefined' ? canUpdateTemplate : false,
    canDeleteTemplate: typeof canDeleteTemplate !== 'undefined' ? canDeleteTemplate : false,
    departments: typeof departments !== 'undefined' && departments ? departments : [],
    initialStages: typeof initialStages !== 'undefined' && initialStages ? initialStages : [],
    initialSpecifications: template.specifications || [],
    initialWorkflowItems: typeof workflowItems !== 'undefined' && workflowItems ? workflowItems : (template.workflowItems || []),
    initialPatterns: typeof patterns !== 'undefined' && patterns ? patterns : (template.patterns || [])
  }) %>
</script>
<script src="/js/production-template-detail.js"></script>
