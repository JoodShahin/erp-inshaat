<link rel="stylesheet" href="/css/production-templates.css">

<!-- 1. Template Master Header -->
<div class="card border-0 shadow-sm mb-3" style="border-radius: 12px; border-right: 5px solid #0984E3 !important;">
  <div class="card-body p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div>
        <div class="d-flex align-items-center gap-3 mb-1">
          <h2 class="fw-bold mb-0 text-dark" id="headerTemplateName"><%= template.name %></h2>
          <span id="headerStatusBadge" class="badge <%= template.isActive ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' %> px-3 py-1 rounded-pill">
            <i class="fa-solid <%= template.isActive ? 'fa-circle-check' : 'fa-circle-xmark' %> me-1"></i>
            <span id="headerStatusText"><%= template.isActive ? 'نشط' : 'معطل' %></span>
          </span>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3 text-muted small mt-2">
          <span><i class="fa-solid fa-barcode me-1 text-secondary"></i> الكود التقني: <strong class="text-dark font-monospace" id="headerTemplateCode"><%= template.code %></strong></span>
          <span>•</span>
          <span><i class="fa-solid fa-hashtag me-1 text-secondary"></i> المرجع: <strong class="text-dark" id="headerTemplateReference"><%= template.referenceNumber || 'غير محدد' %></strong></span>
          <span>•</span>
          <span><i class="fa-solid fa-layer-group me-1 text-secondary"></i> المراحل: <strong class="text-dark header-stat-link" id="headerStageCount" data-tab-target="#tab-template-workflow" title="انتقل إلى مراحل الإنتاج"><%= template.stages ? template.stages.length : 0 %></strong></span>
          <span>•</span>
          <span><i class="fa-solid fa-shapes me-1 text-secondary"></i> الأنماط: <strong class="text-dark header-stat-link" id="headerPatternCount" data-tab-target="#tab-template-workflow" title="انتقل إلى أنماط الإنتاج"><%= template.patterns ? template.patterns.length : 0 %></strong></span>
          <span>•</span>
          <span><i class="fa-solid fa-ruler-combined me-1 text-secondary"></i> المواصفات: <strong class="text-dark header-stat-link" id="headerSpecCount" data-tab-target="#tab-template-specifications" title="انتقل إلى المواصفات الهندسية"><%= template.specifications ? template.specifications.length : 0 %></strong></span>
        </div>
        <p class="text-muted small mt-3 mb-0" id="headerTemplateDescription" style="max-width: 850px;">
          <%= template.description || 'لا يوجد وصف مضاف للقالب.' %>
        </p>
      </div>

      <div class="d-flex flex-wrap align-items-center gap-2">
        <a href="/production/templates" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" style="border-radius: 8px;">
          <i class="fa-solid fa-arrow-right"></i>
          <span>العودة للقائمة</span>
        </a>
        <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
          <button type="button" class="btn btn-outline-primary d-inline-flex align-items-center gap-2" id="btnOpenEditBasicInfo" style="border-radius: 8px;">
            <i class="fa-solid fa-pen-to-square"></i>
            <span>تعديل البيانات الأساسية</span>
          </button>
          <button type="button" id="btnToggleTemplateStatus" class="btn <%= template.isActive ? 'btn-outline-warning' : 'btn-outline-success' %> d-inline-flex align-items-center gap-2" style="border-radius: 8px;">
            <i class="fa-solid <%= template.isActive ? 'fa-ban' : 'fa-check' %>"></i>
            <span id="btnToggleStatusText"><%= template.isActive ? 'تعطيل القالب' : 'تفعيل القالب' %></span>
          </button>
        <% } %>
        <% if (typeof canDeleteTemplate !== 'undefined' && canDeleteTemplate) { %>
          <button type="button" id="btnArchiveTemplate" class="btn btn-outline-danger d-inline-flex align-items-center gap-2" style="border-radius: 8px;">
            <i class="fa-solid fa-trash-can"></i>
            <span>أرشفة</span>
          </button>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- 2. Sticky Workspace Navigation Bar (Isolated Tabs) -->
<div class="template-builder-nav mb-4 p-2 shadow-sm d-flex flex-wrap align-items-center justify-content-between gap-3">
  <div class="d-flex align-items-center gap-2">
    <span class="fw-bold small text-dark d-none d-sm-inline-block px-2">
      <i class="fa-solid fa-compass-drafting text-primary me-1"></i> مساحة العمل:
    </span>
    <ul class="nav nav-pills workspace-tabs gap-2" id="templateWorkspaceTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active d-inline-flex align-items-center gap-2" id="tab-template-info" data-bs-toggle="pill" data-bs-target="#pane-template-info" type="button" role="tab" aria-controls="pane-template-info" aria-selected="true">
          <i class="fa-solid fa-circle-info"></i>
          <span>المعلومات الأساسية</span>
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link d-inline-flex align-items-center gap-2" id="tab-template-specifications" data-bs-toggle="pill" data-bs-target="#pane-template-specifications" type="button" role="tab" aria-controls="pane-template-specifications" aria-selected="false">
          <i class="fa-solid fa-ruler-combined"></i>
          <span>المواصفات الهندسية</span>
          <span class="badge bg-light text-dark rounded-pill ms-1" id="navSpecCountBadge"><%= template.specifications ? template.specifications.length : 0 %></span>
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link d-inline-flex align-items-center gap-2" id="tab-template-workflow" data-bs-toggle="pill" data-bs-target="#pane-template-workflow" type="button" role="tab" aria-controls="pane-template-workflow" aria-selected="false">
          <i class="fa-solid fa-diagram-project"></i>
          <span>مراحل الإنتاج وسير العمل</span>
          <span class="badge bg-light text-dark rounded-pill ms-1" id="navStageCountBadge"><%= template.stages ? template.stages.length : 0 %></span>
        </button>
      </li>
    </ul>
  </div>
  <div class="small text-muted d-none d-lg-flex align-items-center gap-2 px-2">
    <span><i class="fa-solid fa-shield-halved text-success me-1"></i> حفظ وتزامن فوري داخل مساحة العمل</span>
  </div>
</div>

<!-- 3. Workspace Tab Content (Isolated Panes) -->
<div class="tab-content" id="templateWorkspaceContent">
  <!-- PANE 1: Basic Information (#pane-template-info) -->
  <div class="tab-pane fade show active" id="pane-template-info" role="tabpanel" aria-labelledby="tab-template-info">
    <div class="card border-0 shadow-sm mb-4" id="template-info" style="border-radius: 12px;">
      <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <div>
          <h6 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-circle-info me-2 text-primary"></i> البيانات والمعلومات الأساسية
          </h6>
          <span class="text-muted small">المعلومات التعريفية والرمز التقني للقالب</span>
        </div>
        <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
          <button type="button" class="btn btn-sm btn-outline-primary" id="btnQuickEditBasicInfo">
            <i class="fa-solid fa-pen me-1"></i> تعديل البيانات
          </button>
        <% } %>
      </div>
      <div class="card-body p-4">
        <div class="row g-4">
          <div class="col-12 col-md-4">
            <div class="p-3 bg-light rounded-3 border">
              <span class="text-muted small d-block mb-1">اسم القالب:</span>
              <strong class="text-dark fs-6" id="cardTemplateName"><%= template.name %></strong>
            </div>
          </div>
          <div class="col-12 col-md-4">
            <div class="p-3 bg-light rounded-3 border">
              <span class="text-muted small d-block mb-1">الكود التقني (ثابت):</span>
              <span class="badge bg-white text-dark border font-monospace fs-6 px-2 py-1" id="cardTemplateCode"><%= template.code %></span>
            </div>
          </div>
          <div class="col-12 col-md-4">
            <div class="p-3 bg-light rounded-3 border">
              <span class="text-muted small d-block mb-1">الرقم المرجعي:</span>
              <strong class="text-dark fs-6" id="cardTemplateReference"><%= template.referenceNumber || 'غير محدد' %></strong>
            </div>
          </div>
          <div class="col-12">
            <div class="p-3 bg-light rounded-3 border">
              <span class="text-muted small d-block mb-1">الوصف العام للقالب:</span>
              <p class="text-dark mb-0" id="cardTemplateDescription"><%= template.description || 'لا يوجد وصف مضاف لهذا القالب.' %></p>
            </div>
          </div>
        </div>

        <div class="row g-3 mt-3">
          <div class="col-12 col-md-6 col-lg-3">
            <div class="card border border-light-subtle shadow-none h-100 bg-white">
              <div class="card-body d-flex align-items-center gap-3">
                <div class="p-3 bg-primary-subtle text-primary rounded-3">
                  <i class="fa-solid fa-diagram-project fs-4"></i>
                </div>
                <div>
                  <span class="text-muted small d-block">إجمالي المراحل</span>
                  <strong class="fs-5 text-dark"><%= template.stages ? template.stages.length : 0 %></strong>
                </div>
              </div>
            </div>
          </div>
          <div class="col-12 col-md-6 col-lg-3">
            <div class="card border border-light-subtle shadow-none h-100 bg-white">
              <div class="card-body d-flex align-items-center gap-3">
                <div class="p-3 bg-info-subtle text-info rounded-3">
                  <i class="fa-solid fa-ruler-combined fs-4"></i>
                </div>
                <div>
                  <span class="text-muted small d-block">المواصفات الفنية</span>
                  <strong class="fs-5 text-dark"><%= template.specifications ? template.specifications.length : 0 %></strong>
                </div>
              </div>
            </div>
          </div>
          <div class="col-12 col-md-6 col-lg-3">
            <div class="card border border-light-subtle shadow-none h-100 bg-white">
              <div class="card-body d-flex align-items-center gap-3">
                <div class="p-3 bg-success-subtle text-success rounded-3">
                  <i class="fa-solid fa-clock-rotate-left fs-4"></i>
                </div>
                <div>
                  <span class="text-muted small d-block">الحالة التشغيلية</span>
                  <span class="badge <%= template.isActive ? 'bg-success' : 'bg-danger' %>"><%= template.isActive ? 'جاهز للاستخدام' : 'معطل' %></span>
                </div>
              </div>
            </div>
          </div>
          <div class="col-12 col-md-6 col-lg-3">
            <div class="card border border-light-subtle shadow-none h-100 bg-white">
              <div class="card-body d-flex align-items-center gap-3">
                <div class="p-3 bg-secondary-subtle text-secondary rounded-3">
                  <i class="fa-solid fa-calendar-check fs-4"></i>
                </div>
                <div>
                  <span class="text-muted small d-block">تاريخ التحديث</span>
                  <strong class="small text-dark font-monospace"><%= template.updatedAt ? new Date(template.updatedAt).toLocaleDateString('ar-SA') : 'حديثاً' %></strong>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- PANE 2: Engineering Specifications (#pane-template-specifications) -->
  <div class="tab-pane fade" id="pane-template-specifications" role="tabpanel" aria-labelledby="tab-template-specifications">
    <div class="card border-0 shadow-sm mb-4" id="template-specifications" style="border-radius: 12px;">
      <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <div>
          <h5 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-ruler-combined me-2 text-primary"></i> المواصفات الهندسية والمعيارية
          </h5>
          <span class="text-muted small">الأبعاد والخصائص المعيارية للقالب (أطوال، مساحات، أوزان، وغيرها)</span>
        </div>
        <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
          <button type="button" class="btn production-theme-btn px-3 d-inline-flex align-items-center gap-2" id="btnOpenAddSpecModal">
            <i class="fa-solid fa-plus"></i>
            <span>إضافة خاصية هندسية</span>
          </button>
        <% } %>
      </div>
      <div class="card-body p-4">
        <div id="specificationsContainer" class="d-flex flex-column gap-2">
          <% if (template.specifications && template.specifications.length > 0) { %>
            <% template.specifications.forEach(function(spec, index) { %>
              <div class="card border p-2 spec-item" data-spec-id="<%= spec.id %>" data-sort-order="<%= spec.sortOrder %>" style="border-radius: 8px;">
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <strong class="text-dark spec-display-name"><%= spec.name %></strong>
                    <div class="text-muted small">
                      <span class="badge bg-light text-dark border spec-display-value"><%= spec.value %></span>
                      <% if (spec.unit) { %>
                        <span class="ms-1 spec-display-unit"><%= spec.unit %></span>
                      <% } %>
                    </div>
                  </div>
                  <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
                    <div class="d-flex align-items-center gap-1">
                      <button type="button" class="btn btn-sm btn-light p-1 btn-move-spec-up" title="تحريك لأعلى" <%= index === 0 ? 'disabled' : '' %>>
                        <i class="fa-solid fa-arrow-up text-secondary"></i>
                      </button>
                      <button type="button" class="btn btn-sm btn-light p-1 btn-move-spec-down" title="تحريك لأسفل" <%= index === template.specifications.length - 1 ? 'disabled' : '' %>>
                        <i class="fa-solid fa-arrow-down text-secondary"></i>
                      </button>
                      <button type="button" class="btn btn-sm btn-light p-1 btn-edit-spec" title="تعديل">
                        <i class="fa-solid fa-pen text-primary"></i>
                      </button>
                      <button type="button" class="btn btn-sm btn-light p-1 btn-delete-spec" title="حذف">
                        <i class="fa-solid fa-trash-can text-danger"></i>
                      </button>
                    </div>
                  <% } %>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div id="emptySpecsNotice" class="text-center py-4 text-muted border border-dashed rounded-3 bg-light bg-opacity-50">
              <i class="fa-solid fa-ruler-combined fs-2 mb-2 text-secondary opacity-50"></i>
              <p class="mb-1 fw-bold">لم تتم إضافة مواصفات لهذا القالب بعد.</p>
              <p class="small text-muted mb-2">انقر على زر "إضافة خاصية هندسية" لإدخال أبعاد ومواصفات المنتج.</p>
              <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="document.getElementById('btnOpenAddSpecModal').click()">
                  <i class="fa-solid fa-plus me-1"></i> إضافة أول مواصفة
                </button>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- PANE 3: Stages & Workflow (#pane-template-workflow) -->
  <div class="tab-pane fade" id="pane-template-workflow" role="tabpanel" aria-labelledby="tab-template-workflow">
    <div class="card border-0 shadow-sm" id="template-workflow" style="border-radius: 12px;">
      <div class="card-header bg-white border-bottom py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
          <h5 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-diagram-project me-2 text-primary"></i> مراحل الإنتاج وسير العمل (Workflow)
          </h5>
          <p class="text-muted small mb-0">
            ترتيب عالمي للمراحل مع تجميع بصري تلقائي للأقسام المتجاورة. انقر على المرحلة لإدارتها وتحديد موادها ووثائقها المرجعية.
          </p>
        </div>
        <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
          <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-primary px-3 d-inline-flex align-items-center gap-2" id="btnOpenAddPatternModal" style="border-radius: 8px;">
              <i class="fa-solid fa-shapes"></i>
              <span>إضافة نمط</span>
            </button>
            <button type="button" class="btn production-theme-btn px-3 d-inline-flex align-items-center gap-2" id="btnOpenAddStageModal">
              <i class="fa-solid fa-plus"></i>
              <span>إضافة مرحلة</span>
            </button>
          </div>
        <% } %>
      </div>

      <div class="card-body p-4">
        <!-- Consecutive Department Groups Container -->
        <div id="workflowGroupsContainer">
          <!-- Dynamically populated via client JavaScript -->
        </div>

        <!-- Empty Stages State Notice -->
        <div id="emptyStagesNotice" class="text-center py-5 text-muted border border-dashed rounded-3 bg-light bg-opacity-50 <%= template.stages && template.stages.length > 0 ? 'd-none' : '' %>">
          <i class="fa-solid fa-diagram-project fs-1 mb-3 text-secondary opacity-50"></i>
          <h5 class="fw-bold mb-1 text-dark">لم يتم إضافة مراحل إنتاج لهذا القالب بعد.</h5>
          <p class="small text-muted mb-3">ابدأ بإضافة أول مرحلة إلى سير العمل وتحديد القسم التشغيلي والمواد والوثائق التنفيذية.</p>
          <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
            <button type="button" class="btn production-theme-btn px-4" onclick="document.getElementById('btnOpenAddStageModal').click()">
              <i class="fa-solid fa-plus me-1"></i> إضافة أول مرحلة
            </button>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ======================================================== -->
<!-- STAGE MODAL (Centered Unified Stage Workspace Dialog)     -->
<!-- ======================================================== -->
<div class="modal fade stage-modal" id="stageModal" tabindex="-1" aria-labelledby="stageDrawerTitle" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header py-3 px-4 bg-white border-bottom">
        <div class="d-flex align-items-center gap-3 flex-grow-1 overflow-hidden">
          <span class="badge bg-primary fs-6 py-2 px-3 rounded-pill shadow-sm" id="stageDrawerOrderBadge">#1</span>
          <div>
            <h5 class="modal-title fw-bold text-dark text-truncate mb-1" id="stageDrawerTitle">تفاصيل المرحلة</h5>
            <span class="badge bg-secondary-subtle text-secondary small px-2 py-1" id="stageDrawerDeptBadge">القسم</span>
          </div>
        </div>
        <button type="button" class="btn-close ms-2" data-bs-dismiss="modal" aria-label="إغلاق"></button>
      </div>

      <!-- Stage Modal Tabs Header -->
      <ul class="nav nav-tabs stage-modal-tabs px-4 pt-2 bg-light border-bottom" id="stageDrawerTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" id="tab-stage-info" data-bs-toggle="tab" data-bs-target="#pane-stage-info" type="button" role="tab">
            <i class="fa-solid fa-sliders me-1"></i> معلومات المرحلة
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="tab-stage-materials" data-bs-toggle="tab" data-bs-target="#pane-stage-materials" type="button" role="tab">
            <i class="fa-solid fa-boxes-stacked me-1"></i> المواد المخططة <span class="badge bg-primary-subtle text-primary ms-1" id="drawerTabMaterialsBadge">0</span>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="tab-stage-attachments" data-bs-toggle="tab" data-bs-target="#pane-stage-attachments" type="button" role="tab">
            <i class="fa-solid fa-paperclip me-1"></i> الوثائق المرجعية <span class="badge bg-info-subtle text-info ms-1" id="drawerTabAttachmentsBadge">0</span>
          </button>
        </li>
      </ul>

      <!-- Stage Modal Body -->
      <div class="modal-body p-4">
    <div class="tab-content">
      <!-- 1. TAB: Stage Info -->
      <div class="tab-pane fade show active" id="pane-stage-info" role="tabpanel">
        <form id="drawerStageInfoForm" class="needs-validation" novalidate>
          <div class="mb-3">
            <label for="drawerStageName" class="form-label fw-bold small text-dark">اسم المرحلة <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="drawerStageName" required>
            <div class="invalid-feedback">يرجى إدخال اسم المرحلة.</div>
          </div>

          <div class="mb-3">
            <label for="drawerStageDepartmentId" class="form-label fw-bold small text-dark">القسم التشغيلي المسؤول <span class="text-danger">*</span></label>
            <select class="form-select" id="drawerStageDepartmentId" required>
              <option value="">-- اختر القسم الإنتاجي --</option>
              <% if (typeof departments !== 'undefined' && departments) { %>
                <% departments.forEach(function(dept) { %>
                  <option value="<%= dept.id %>"><%= dept.name %> (<%= dept.code %>)</option>
                <% }); %>
              <% } %>
            </select>
            <div class="form-text text-muted">تغيير القسم يعيد تجميع المراحل بصرياً دون المساس بترتيبها العالمي.</div>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-7">
              <label for="drawerStageDuration" class="form-label fw-bold small text-dark">المدة التقديرية</label>
              <div class="input-group">
                <input type="number" class="form-control" id="drawerStageDuration" min="1" step="1" placeholder="المدة">
                <select class="form-select" id="drawerStageDurationUnit" style="max-width: 105px;">
                  <option value="MINUTES" selected>دقائق</option>
                  <option value="HOURS">ساعات</option>
                  <option value="DAYS">أيام</option>
                </select>
              </div>
            </div>
            <div class="col-5">
              <label for="drawerStageCost" class="form-label fw-bold small text-dark">التكلفة التقديرية (اختياري)</label>
              <input type="number" class="form-control" id="drawerStageCost" min="0" step="0.01" placeholder="0.00">
            </div>
          </div>

          <div class="mb-4">
            <label for="drawerStageDescription" class="form-label fw-bold small text-dark">الوصف وملاحظات التنفيذ</label>
            <textarea class="form-control" id="drawerStageDescription" rows="3" placeholder="تعليمات تشغيلية محددة لهذه المرحلة..."></textarea>
          </div>

          <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
              <button type="button" class="btn btn-outline-danger btn-sm" id="btnDrawerArchiveStage">
                <i class="fa-solid fa-trash-can me-1"></i> أرشفة المرحلة
              </button>
              <button type="submit" class="btn production-theme-btn px-4" id="btnSaveDrawerStageInfo">
                <i class="fa-solid fa-floppy-disk me-1"></i> حفظ التعديلات
              </button>
            </div>
          <% } %>
        </form>
      </div>

      <!-- 2. TAB: Planned Materials -->
      <div class="tab-pane fade" id="pane-stage-materials" role="tabpanel">
        <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
          <!-- Add Material Card -->
          <div class="card border mb-4 bg-light bg-opacity-50" style="border-radius: 10px;">
            <div class="card-body p-3">
              <h6 class="fw-bold mb-2 small text-dark"><i class="fa-solid fa-plus-circle me-1 text-primary"></i> إضافة مادة مخططة من الكتالوج</h6>
              
              <!-- Product Search & Picker -->
              <div class="mb-3 position-relative">
                <label for="catalogProductSearchInput" class="form-label small fw-bold text-dark">البحث في كتالوج المنتجات:</label>
                <div class="input-group input-group-sm">
                  <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                  <input type="text" class="form-control" id="catalogProductSearchInput" placeholder="ابحث باسم المادة أو الكود...">
                </div>
                
                <!-- Search Results Box -->
                <div id="catalogSearchResultsBox" class="catalog-search-results-box d-none mt-1 shadow-sm">
                  <div id="catalogSearchResultsList"></div>
                  <div class="p-2 text-center border-top bg-light d-none" id="catalogLoadMoreContainer">
                    <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" id="btnCatalogLoadMore">
                      <i class="fa-solid fa-circle-chevron-down me-1"></i> تحميل المزيد من النتائج
                    </button>
                  </div>
                </div>

                <!-- Selected Product Badge -->
                <div id="selectedProductContainer" class="d-none mt-2 p-2 bg-white border rounded d-flex justify-content-between align-items-center">
                  <div>
                    <span class="badge bg-primary font-monospace me-1" id="selectedProductCode">CODE</span>
                    <strong class="text-dark small" id="selectedProductName">اسم المنتج</strong>
                  </div>
                  <button type="button" class="btn btn-sm btn-link text-danger p-0" id="btnDeselectProduct">إلغاء الاختيار</button>
                </div>
              </div>

              <!-- Unit & Quantity Inputs -->
              <form id="drawerAddMaterialForm" class="row g-2 align-items-end needs-validation" novalidate>
                <input type="hidden" id="selectedProductId">

                <div class="col-7">
                  <label for="drawerMaterialUnitSelect" class="form-label fw-bold small text-dark">وحدة القياس <span class="text-danger">*</span></label>
                  <select class="form-select form-select-sm" id="drawerMaterialUnitSelect" required disabled>
                    <option value="">-- اختر الوحدة --</option>
                  </select>
                  <div class="invalid-feedback">يرجى اختيار الوحدة.</div>
                </div>

                <div class="col-5">
                  <label for="drawerMaterialQuantityInput" class="form-label fw-bold small text-dark">الكمية المخططة <span class="text-danger">*</span></label>
                  <input type="number" class="form-control form-control-sm" id="drawerMaterialQuantityInput" min="0.000001" step="any" placeholder="الكمية" required disabled>
                  <div class="invalid-feedback">أدخل كمية > 0</div>
                </div>

                <div class="col-12 text-end mt-2">
                  <button type="submit" id="btnSubmitDrawerMaterial" class="btn btn-sm production-theme-btn px-4" disabled>
                    <i class="fa-solid fa-plus me-1"></i> إضافة المادة للمرحلة
                  </button>
                </div>
              </form>
            </div>
          </div>
        <% } %>

        <!-- Existing Materials Table -->
        <h6 class="fw-bold mb-2 small text-dark"><i class="fa-solid fa-list me-1 text-muted"></i> المواد المحددة لهذه المرحلة</h6>
        <div class="table-responsive border rounded-3 mb-2">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr class="small text-muted">
                <th>المادة</th>
                <th>الكود</th>
                <th>الوحدة</th>
                <th class="text-center">الكمية</th>
                <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
                  <th class="text-center" style="width: 50px;">حذف</th>
                <% } %>
              </tr>
            </thead>
            <tbody id="drawerStageMaterialsTableBody">
              <!-- Dynamically populated via client JS -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- 3. TAB: Reference Documents -->
      <div class="tab-pane fade" id="pane-stage-attachments" role="tabpanel">
        <div class="alert alert-info py-2 px-3 small mb-3 border-0 bg-info-subtle text-info-emphasis">
          <i class="fa-solid fa-circle-info me-1"></i>
          <strong>الوثائق المرجعية للقالب:</strong> مخططات تصميمية، أدلة تنفيذية، أو صور توضيحية تدعم تنفيذ المرحلة (الأنواع المسموحة: PDF, PNG, JPG, WEBP بحد أقصى 20 ميغابايت).
        </div>

        <% if (typeof canUpdateTemplate !== 'undefined' && canUpdateTemplate) { %>
          <!-- Upload Box -->
          <div class="card border mb-4 bg-light bg-opacity-50" style="border-radius: 10px;">
            <div class="card-body p-3">
              <h6 class="fw-bold mb-2 small text-dark"><i class="fa-solid fa-cloud-arrow-up me-1 text-primary"></i> إرفاق وثيقة مرجعية جديدة</h6>
              <form id="drawerUploadAttachmentForm" class="needs-validation" novalidate>
                <div class="mb-2">
                  <label for="attachmentFileInput" class="form-label small fw-bold text-dark">الملف <span class="text-danger">*</span></label>
                  <input type="file" class="form-control form-control-sm" id="attachmentFileInput" accept=".pdf,.png,.jpg,.jpeg,.webp" required>
                  <div class="invalid-feedback">يرجى اختيار ملف صالح (PDF أو صورة).</div>
                </div>
                <div class="mb-3">
                  <label for="attachmentDescriptionInput" class="form-label small fw-bold text-dark">وصف الوثيقة (اختياري)</label>
                  <input type="text" class="form-control form-control-sm" id="attachmentDescriptionInput" maxlength="500" placeholder="مثال: مخطط تسليح الأرضية المعتمد">
                </div>
                <div class="d-flex justify-content-end">
                  <button type="submit" id="btnUploadAttachment" class="btn btn-sm production-theme-btn px-4 d-inline-flex align-items-center gap-2">
                    <span class="spinner-border spinner-border-sm d-none" id="uploadSpinner" role="status" aria-hidden="true"></span>
                    <i class="fa-solid fa-upload"></i>
                    <span>رفع الوثيقة</span>
                  </button>
                </div>
              </form>
            </div>
          </div>
        <% } %>

        <!-- Existing Attachments List -->
        <h6 class="fw-bold mb-2 small text-dark"><i class="fa-solid fa-paperclip me-1 text-muted"></i> الوثائق المرفقة حالياً</h6>
        <div id="drawerStageAttachmentsList" class="d-flex flex-column gap-2">
          <!-- Dynamically populated via client JS -->
        </div>
      </div>
    </div>
  </div>
</div>
</div>
</div>

