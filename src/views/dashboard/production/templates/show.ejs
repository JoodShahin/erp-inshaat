              <option value="">-- اختر القسم الإنتاجي --</option>
              <% if (typeof departments !== 'undefined' && departments) { %>
                <% departments.forEach(function(dept) { %>
                  <option value="<%= dept.id %>"><%= dept.name %> (<%= dept.code %>)</option>
