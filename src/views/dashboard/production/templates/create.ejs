<link rel="stylesheet" href="/css/production-templates.css">

<!-- Header with Back Button -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="fw-bold mb-1" style="color: #1F2937;">
      إنشاء قالب تصنيع جديد <i class="fa-solid fa-compass-drafting text-muted fs-5 ms-2"></i>
    </h3>
    <p class="text-muted mb-0 small">الخطوة الأولى: تحديد هوية القالب الأساسية ثم الانتقال لمساحة العمل لإكمال المواصفات ومراحل الإنتاج</p>
  </div>
  <a href="/production/templates" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" style="border-radius: 8px;">
    <i class="fa-solid fa-arrow-right"></i>
    <span>العودة للقائمة</span>
  </a>
</div>

<!-- Alert Container -->
<div id="formAlert" class="alert alert-danger d-none mb-4" role="alert"></div>

<div class="row justify-content-center">
  <div class="col-12 col-lg-8">
    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
      <div class="card-header bg-white border-bottom py-3">
        <h6 class="fw-bold mb-0 text-dark">
          <i class="fa-solid fa-cube me-2 text-primary"></i> هوية وبيانات القالب الأساسية
        </h6>
      </div>
      <div class="card-body p-4">
        <form id="createTemplateForm" class="needs-validation" novalidate>
          <!-- Template Name -->
          <div class="mb-4">
            <label for="templateName" class="form-label fw-bold text-dark">اسم القالب <span class="text-danger">*</span></label>
            <div class="input-group has-validation">
              <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-cubes"></i></span>
              <input type="text" class="form-control" id="templateName" name="name" required maxlength="150" placeholder="مثال: غرفة سكنية نموذج A">
              <div class="invalid-feedback">يرجى إدخال اسم القالب.</div>
            </div>
            <div class="form-text text-muted">الاسم المعياري للمنتج أو الغرفة المصنعة.</div>
          </div>

          <div class="row g-3 mb-4">
            <!-- Technical Code Notice (Auto-Generated) -->
            <div class="col-md-6">
              <label class="form-label fw-bold text-dark">الكود التقني (Code)</label>
              <div class="input-group">
                <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-barcode"></i></span>
                <input type="text" class="form-control bg-light text-muted font-monospace" disabled value="توليد تلقائي (مثل PT-000001)">
              </div>
              <div class="form-text text-muted">يولده الخادم تلقائياً بصيغة تسلسلية مع إنشاء الإصدار الأولي 1.0.</div>
            </div>

            <!-- Reference Number -->
            <div class="col-md-6">
              <label for="templateReferenceNumber" class="form-label fw-bold text-dark">الرقم المرجعي (Reference Number)</label>
              <div class="input-group">
                <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-hashtag"></i></span>
                <input type="text" class="form-control" id="templateReferenceNumber" name="referenceNumber" maxlength="100" placeholder="مثال: REF-A01-2026">
              </div>
              <div class="form-text text-muted">الرقم المرجعي الاختياري المستخدم في المخططات أو دفاتر الشروط.</div>
            </div>
          </div>

          <!-- Description -->
          <div class="mb-4">
            <label for="templateDescription" class="form-label fw-bold text-dark">الوصف والتفاصيل العامة</label>
            <textarea class="form-control" id="templateDescription" name="description" rows="3" placeholder="ملاحظات تفصيلية أو شروط تخطيطية للقالب..."></textarea>
          </div>

          <!-- Status / Active -->
          <div class="mb-4">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="templateIsActive" name="isActive" checked>
              <label class="form-check-label fw-bold" for="templateIsActive">القالب نشط وجاهز للاستخدام</label>
            </div>
            <div class="form-text text-muted">القوالب غير النشطة تظل محفوظة دون إمكانية استخدامها في أوامر الإنتاج الجديدة.</div>
          </div>

          <!-- Action Buttons -->
          <div class="d-flex justify-content-between align-items-center pt-3 border-top">
            <a href="/production/templates" class="btn btn-light px-4">إلغاء</a>
            <button type="submit" id="btnSubmitTemplate" class="btn btn-primary px-4 py-2 d-inline-flex align-items-center gap-2 fw-semibold" style="border-radius: 8px;">
              <span class="spinner-border spinner-border-sm d-none" id="submitSpinner" role="status" aria-hidden="true"></span>
              <i class="fa-solid fa-arrow-left"></i>
              <span>إنشاء ومتابعة إعداد القالب</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('createTemplateForm');
    const alertBox = document.getElementById('formAlert');
    const btnSubmit = document.getElementById('btnSubmitTemplate');
    const spinner = document.getElementById('submitSpinner');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertBox.classList.add('d-none');
      alertBox.textContent = '';

      if (!form.checkValidity()) {
        form.classList.add('was-validated');
        return;
      }

      const name = document.getElementById('templateName').value.trim();
      const referenceNumber = document.getElementById('templateReferenceNumber').value.trim() || undefined;
      const description = document.getElementById('templateDescription').value.trim() || undefined;
      const isActive = document.getElementById('templateIsActive').checked;

      const payload = {
        name,
        referenceNumber,
        description,
        isActive
      };

      btnSubmit.disabled = true;
      spinner.classList.remove('d-none');

      try {
        const res = await window.erpFetch('/api/production/templates', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (res.ok && data.success) {
          const createdTemplateId = data.data.id;
          sessionStorage.setItem('pendingToast', 'تم إنشاء هوية القالب بنجاح مع الإصدار الأولي 1.0.');
          window.location.href = `/production/templates/${createdTemplateId}`;
        } else {
          const msg = data.message || (data.errors ? Object.values(data.errors).flat().join('، ') : 'حدث خطأ أثناء حفظ القالب');
          alertBox.textContent = msg;
          alertBox.classList.remove('d-none');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      } catch {
        alertBox.textContent = 'تعذر الاتصال بالخادم. يرجى المحاولة مرة أخرى.';
        alertBox.classList.remove('d-none');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } finally {
        btnSubmit.disabled = false;
        spinner.classList.add('d-none');
      }
    });
  });
</script>
