<link rel="stylesheet" href="/css/production-orders.css">

<!-- Header & Actions -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <h3 class="fw-bold mb-1" style="color: #1F2937;">
      أوامر الإنتاج <i class="fa-solid fa-clipboard-list text-muted fs-5 ms-2"></i>
    </h3>
    <p class="text-muted mb-0 small">إعداد وصياغة مسودات أوامر الإنتاج وتحديد خيارات الأنماط لكل بند قبل الاعتماد</p>
  </div>
  <% if (typeof canCreateOrder !== 'undefined' && canCreateOrder) { %>
    <a href="/production/orders/create" class="btn production-theme-btn d-inline-flex align-items-center gap-2">
      <i class="fa-solid fa-plus"></i>
      <span>إنشاء أمر إنتاج جديد</span>
    </a>
  <% } %>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
  <!-- Card 1: Total Orders -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="card border-0 shadow-sm order-kpi-card" style="border-radius: 12px; border-right: 5px solid #0984E3 !important;">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small fw-semibold mb-1">إجمالي أوامر الإنتاج</div>
            <div class="fs-4 fw-bold font-monospace" style="color: #0984E3;" id="kpiTotalOrders">0</div>
          </div>
          <div class="order-kpi-icon rounded-circle d-flex justify-content-center align-items-center flex-shrink-0" style="background-color: rgba(9, 132, 227, 0.1); color: #0984E3;">
            <i class="fa-solid fa-clipboard-list fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 2: Draft Orders -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="card border-0 shadow-sm order-kpi-card" style="border-radius: 12px; border-right: 5px solid #FF9F43 !important;">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small fw-semibold mb-1">أوامر في مرحلة المسودة</div>
            <div class="fs-4 fw-bold font-monospace" style="color: #FF9F43;" id="kpiDraftOrders">0</div>
          </div>
          <div class="order-kpi-icon rounded-circle d-flex justify-content-center align-items-center flex-shrink-0" style="background-color: rgba(255, 159, 67, 0.1); color: #FF9F43;">
            <i class="fa-solid fa-pen-ruler fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 3: Approved Orders -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="card border-0 shadow-sm order-kpi-card" style="border-radius: 12px; border-right: 5px solid #10AC84 !important;">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small fw-semibold mb-1">أوامر معتمدة</div>
            <div class="fs-4 fw-bold font-monospace" style="color: #10AC84;" id="kpiApprovedOrders">0</div>
          </div>
          <div class="order-kpi-icon rounded-circle d-flex justify-content-center align-items-center flex-shrink-0" style="background-color: rgba(16, 172, 132, 0.1); color: #10AC84;">
            <i class="fa-solid fa-circle-check fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 4: Planned Quantity -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="card border-0 shadow-sm order-kpi-card" style="border-radius: 12px; border-right: 5px solid #6C5CE7 !important;">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small fw-semibold mb-1">إجمالي الكميات المخططة</div>
            <div class="fs-4 fw-bold font-monospace" style="color: #6C5CE7;" id="kpiTotalQuantity">0</div>
          </div>
          <div class="order-kpi-icon rounded-circle d-flex justify-content-center align-items-center flex-shrink-0" style="background-color: rgba(108, 92, 231, 0.1); color: #6C5CE7;">
            <i class="fa-solid fa-cubes fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
  <div class="card-body p-3">
    <div class="row g-2 align-items-center">
      <div class="col-12 col-md-6 col-lg-4">
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 text-muted">
            <i class="fa-solid fa-search"></i>
          </span>
          <input type="text" id="orderSearchInput" class="form-control border-start-0 bg-light" placeholder="البحث برقم الطلب أو العنوان أو الوصف..." autocomplete="off">
        </div>
      </div>
      <div class="col-12 col-md-4 col-lg-3">
        <select id="orderPriorityFilter" class="form-select bg-light" aria-label="تصفية حسب الأولوية">
          <option value="">كل الأولويات</option>
          <option value="CRITICAL">حرجة</option>
          <option value="HIGH">عالية</option>
          <option value="NORMAL">عادية</option>
          <option value="LOW">منخفضة</option>
        </select>
      </div>
      <div class="col-auto ms-auto">
        <button id="refreshOrdersBtn" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" style="border-radius: 8px;">
          <i class="fa-solid fa-arrows-rotate"></i>
          <span>تحديث</span>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; overflow: hidden;">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" id="ordersTable">
      <thead class="bg-light border-bottom">
        <tr>
          <th class="py-3 px-3 text-secondary text-nowrap fw-bold" style="font-size: 0.85rem;">رقم الطلب</th>
          <th class="py-3 px-3 text-secondary text-nowrap fw-bold" style="font-size: 0.85rem;">الأولوية</th>
          <th class="py-3 px-3 text-secondary text-nowrap fw-bold" style="font-size: 0.85rem;">الحالة</th>
          <th class="py-3 px-3 text-secondary text-nowrap fw-bold" style="font-size: 0.85rem;">العنوان</th>
          <th class="py-3 px-3 text-secondary text-nowrap fw-bold text-center" style="font-size: 0.85rem;">عدد البنود</th>
          <th class="py-3 px-3 text-secondary text-nowrap fw-bold text-center" style="font-size: 0.85rem;">إجمالي الكمية</th>
          <th class="py-3 px-3 text-secondary text-nowrap fw-bold" style="font-size: 0.85rem;">منشئ الطلب</th>
          <th class="py-3 px-3 text-secondary text-nowrap fw-bold" style="font-size: 0.85rem;">تاريخ الإنشاء</th>
          <th class="py-3 px-3 text-secondary text-nowrap fw-bold text-end" style="font-size: 0.85rem;">الإجراءات</th>
        </tr>
      </thead>
      <tbody id="ordersTableBody">
        <tr>
          <td colspan="9" class="text-center py-5 text-muted">
            <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
            جاري تحميل أوامر الإنتاج...
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Empty State (hidden by default) -->
  <div id="emptyOrdersState" class="text-center py-5 d-none">
    <div class="mb-3 text-muted" style="font-size: 3rem;">
      <i class="fa-solid fa-clipboard-question"></i>
    </div>
    <h5 class="fw-bold text-dark mb-1">لا توجد أوامر إنتاج مطابقة</h5>
    <p class="text-muted small mb-3">لم يتم العثور على أي أوامر إنتاج مسجلة حتى الآن.</p>
    <% if (typeof canCreateOrder !== 'undefined' && canCreateOrder) { %>
      <a href="/production/orders/create" class="btn production-theme-btn btn-sm">
        <i class="fa-solid fa-plus me-1"></i> إنشاء أول أمر إنتاج
      </a>
    <% } %>
  </div>

  <!-- Pagination Footer -->
  <div class="card-footer bg-white border-top py-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
    <div class="text-muted small" id="ordersPaginationInfo">
      عرض 0 من إجمالي 0 أمر
    </div>
    <nav aria-label="Page navigation">
      <ul class="pagination pagination-sm mb-0 gap-1" id="ordersPaginationList">
        <!-- Built dynamically -->
      </ul>
    </nav>
  </div>
</div>

<script>
  window.canUpdateOrder = <%= typeof canUpdateOrder !== 'undefined' && canUpdateOrder ? 'true' : 'false' %>;
  window.canDeleteOrder = <%= typeof canDeleteOrder !== 'undefined' && canDeleteOrder ? 'true' : 'false' %>;
</script>
<script src="/js/production-orders.js"></script>
