<link rel="stylesheet" href="/css/production-orders.css">
<style>
  .edit-order-header {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 1.5rem;
  }
</style>

<!-- Initial Order JSON Payload (safely escaped) -->
<script type="application/json" id="initialOrderData">
  <%- initialOrderJson %>
</script>

<!-- Page Header Card -->
<div class="edit-order-header mb-4 shadow-sm">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
      <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
        <h3 class="fw-bold mb-0 text-dark">
          إعداد أمر الإنتاج <span class="font-monospace text-primary" style="font-weight: 700;" id="headerOrderNumber"><%= order.orderNumber %></span>
        </h3>
        <span class="badge bg-warning-subtle text-warning-emphasis px-3 py-1 rounded-pill">
          <i class="fa-solid fa-file-pen me-1"></i> مسودة
        </span>
        <% if (order.priority === 'CRITICAL') { %>
          <span class="badge bg-danger-subtle text-danger-emphasis px-3 py-1 rounded-pill">
            <i class="fa-solid fa-flag text-danger me-1"></i> أولوية حرجة
          </span>
        <% } else if (order.priority === 'HIGH') { %>
          <span class="badge bg-warning-subtle text-warning-emphasis px-3 py-1 rounded-pill">
            <i class="fa-solid fa-flag text-warning me-1"></i> أولوية عالية
          </span>
        <% } else if (order.priority === 'LOW') { %>
          <span class="badge bg-secondary-subtle text-secondary-emphasis px-3 py-1 rounded-pill">
            <i class="fa-solid fa-flag text-secondary me-1"></i> أولوية منخفضة
          </span>
        <% } else { %>
          <span class="badge bg-primary-subtle text-primary-emphasis px-3 py-1 rounded-pill">
            <i class="fa-solid fa-flag text-primary me-1"></i> أولوية عادية
          </span>
        <% } %>
        <div id="readinessStatusBadge" class="d-inline-flex"></div>
      </div>
      <p class="text-muted mb-0 small">إدارة وتعديل بنود أمر الإنتاج، ضبط الكميات وتخصيص خيارات الأنماط</p>
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
      <a href="/production/orders/<%= order.id %>" id="viewOrderNavBtn" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-3 py-2" style="border-radius: 8px;">
        <i class="fa-solid fa-eye"></i>
        <span>عرض الطلب</span>
      </a>
      <a href="/production/orders" id="backToListNavBtn" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-3 py-2" style="border-radius: 8px;">
        <i class="fa-solid fa-arrow-right"></i>
        <span>قائمة الأوامر</span>
      </a>
      <% if (typeof canDeleteOrder !== 'undefined' && canDeleteOrder) { %>
        <button type="button" id="archiveOrderBtn" class="btn btn-outline-danger d-inline-flex align-items-center gap-1 px-3 py-2" style="border-radius: 8px;">
          <i class="fa-solid fa-trash-can"></i>
          <span>أرشفة الطلب</span>
        </button>
      <% } %>
    </div>
  </div>
</div>

<!-- Alert Container -->
<div id="orderAlert" class="alert alert-danger d-none mb-4" role="alert"></div>

<!-- Compact Order Summary Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 14px; border: 1px solid #e2e8f0;">
  <div class="card-body p-4">
    <div class="row g-3 align-items-center">
      <div class="col-12 col-lg-7">
        <div class="d-flex align-items-center gap-2 text-muted small fw-semibold mb-1">
          <i class="fa-solid fa-circle-info text-primary"></i>
          <span>العنوان والوصف والملاحظات:</span>
        </div>
        <p class="fw-bold text-dark mb-1" id="orderTitleText"><%= order.title %></p>
        <p class="text-dark mb-2 small" id="orderDescriptionText">
          <%= order.description || 'لا يوجد وصف محدد لهذا الطلب.' %>
        </p>

        <div class="p-2 px-3 rounded-3 bg-light border border-light-subtle text-muted small mb-2 <%= order.notes ? '' : 'd-none' %>" id="orderNotesBox">
          <% if (order.notes) { %>
            <i class="fa-solid fa-note-sticky me-1 text-warning"></i> <strong>ملاحظات:</strong> <%= order.notes %>
          <% } %>
        </div>

        <div class="d-flex align-items-center gap-3 text-muted small flex-wrap pt-1">
          <span><i class="fa-solid fa-user-circle me-1 text-secondary"></i> المنشئ: <strong><%= order.createdByUser ? order.createdByUser.fullName : 'غير محدد' %></strong></span>
          <span>•</span>
          <span><i class="fa-solid fa-calendar-day me-1 text-secondary"></i> التاريخ: <span id="orderCreatedAt"><%= new Date(order.createdAt).toLocaleDateString('ar-EG') %></span></span>
          <% if (typeof canUpdateOrder !== 'undefined' && canUpdateOrder) { %>
            <span>•</span>
            <button type="button" id="editHeaderBtn" class="btn btn-link btn-sm p-0 text-decoration-none text-primary fw-semibold">
              <i class="fa-solid fa-pen-to-square me-1"></i> تعديل البيانات
            </button>
          <% } %>
        </div>
      </div>

      <div class="col-12 col-lg-5">
        <div class="row g-2 text-center">
          <div class="col-6">
            <div class="p-3 rounded-3 bg-light border border-light-subtle">
              <div class="text-muted small fw-semibold mb-1">عدد البنود</div>
              <div class="fs-4 fw-bold text-dark font-monospace" id="headerLineCount"><%= order.summary.lineCount %></div>
            </div>
          </div>
          <div class="col-6">
            <div class="p-3 rounded-3 bg-light border border-light-subtle">
              <div class="text-muted small fw-semibold mb-1">إجمالي الكمية</div>
              <div class="fs-4 fw-bold text-primary font-monospace" id="headerTotalQuantity"><%= order.summary.totalQuantity %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Readiness Breakdown Panel (Dynamically shown when issues exist) -->
<div id="readinessPanel" class="card border-0 shadow-sm mb-4 d-none" style="border-radius: 14px; border-right: 5px solid #FF9F43 !important; background-color: #FFFDF8; border: 1px solid #fed7aa;">
  <div class="card-body p-3 p-md-4">
    <div class="d-flex align-items-center justify-content-between mb-2">
      <div class="fw-bold text-warning-emphasis d-flex align-items-center gap-2">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>تنبيهات حالة الجاهزية</span>
      </div>
      <button type="button" id="recheckReadinessBtn" class="btn btn-outline-secondary btn-sm py-1 px-2" style="font-size: 0.75rem; border-radius: 6px;">
        <i class="fa-solid fa-arrows-rotate me-1"></i> تحديث الفحص
      </button>
    </div>
    <ul class="readiness-issues-list mb-0 pe-3" id="readinessIssuesList">
      <!-- Populated dynamically -->
    </ul>
  </div>
</div>

<!-- ========================================================================= -->
<!-- Unified Production Order Lines Workspace -->
<!-- (Single container directly hosting Search, Staging, and All Order Lines) -->
<!-- ========================================================================= -->
<div class="card border-0 shadow-sm main-lines-workspace-card mb-4" id="addLineComposerCard">
  <div class="card-body p-4">
    <!-- Workspace Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-2">
      <div>
        <h5 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
          <i class="fa-solid fa-layer-group text-primary"></i>
          <span>بنود أمر الإنتاج</span>
        </h5>
        <p class="text-muted small mb-0">يمكنك تعديل بنود الطلب مباشرة، أو البحث عن قالب لإضافة بنود جديدة للطلب</p>
      </div>
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-secondary-subtle text-secondary-emphasis px-3 py-2 rounded-pill font-monospace" id="existingLinesCountBadge">
          <%= (order.lines ? order.lines.length : 0) %> بند
        </span>
      </div>
    </div>

    <!-- Search Input Group (Search-First) -->
    <div class="search-bar-wrapper mb-4">
      <div class="input-group input-group-lg composer-search-input-group position-relative">
        <span class="input-group-text bg-white text-muted ps-3">
          <i class="fa-solid fa-magnifying-glass"></i>
        </span>
        <input
          type="text"
          id="templateSearchInput"
          class="form-control ps-1"
          placeholder="ابحث باسم القالب أو الكود أو الرقم المرجعي لإضافة بند جديد..."
          autocomplete="off"
        >
        <button type="button" id="clearSearchBtn" class="btn btn-link text-muted pe-3 d-none" title="مسح البحث" aria-label="مسح البحث">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Dropdown Search Results directly below the search input -->
      <div id="searchResultsWrapper" class="mt-2 d-none">
        <div id="searchResultsList" class="list-group search-results-list border">
          <!-- Rendered dynamically as <button type="button" class="list-group-item list-group-item-action ..."> -->
        </div>
        <button type="button" id="templateLoadMoreBtn" class="btn btn-sm btn-outline-secondary w-100 mt-2 d-none">
          <i class="fa-solid fa-arrow-down me-1"></i> تحميل المزيد
        </button>
      </div>

      <div id="composerAlert" class="alert alert-danger d-none mt-3 mb-0" role="alert"></div>
    </div>

    <!-- Unified Order Lines Container (Directly under search) -->
    <div id="orderLinesContainer" class="d-flex flex-column gap-3 mb-3">
      <!-- Rendered dynamically by production-order-edit.js on page load -->
    </div>

    <!-- Empty Lines State (Shown only when order has no lines) -->
    <div id="emptyLinesState" class="card border-0 bg-light text-center py-5 <%= (!order.lines || order.lines.length === 0) ? '' : 'd-none' %>" style="border-radius: 12px;">
      <div class="card-body py-4">
        <div class="mb-3 text-secondary opacity-50" style="font-size: 3rem;">
          <i class="fa-solid fa-cubes-stacked"></i>
        </div>
        <h5 class="fw-bold text-dark mb-1">لا توجد بنود إنتاج في هذا الطلب بعد</h5>
        <p class="text-muted small mb-0">استخدم مربع البحث أعلاه لاختيار قالب وإضافة أول بند إنتاج.</p>
      </div>
    </div>

    <!-- Bottom Save Action Bar -->
    <div class="card border-0 shadow-sm p-3 bg-white mt-4 border" style="border-radius: 12px; border-color: #e2e8f0 !important;" id="editorBottomActionBar">
      <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
        <div class="text-muted small">
          <i class="fa-solid fa-circle-check text-success me-1"></i>
          <span>عند حفظ أمر الإنتاج سيتم تحديث جميع البنود والخيارات والانتقال إلى صفحة عرض الطلب.</span>
        </div>
        <div class="d-flex align-items-center gap-2">
          <a href="/production/orders/<%= order.id %>" id="bottomCancelBtn" class="btn btn-outline-secondary px-3 py-2" style="border-radius: 8px;">
            <span>إلغاء</span>
          </a>
          <button type="button" id="submitPendingLinesBtn" class="btn production-theme-btn px-4 py-2 d-inline-flex align-items-center gap-2" style="border-radius: 8px;">
            <span class="spinner-border spinner-border-sm d-none" id="submitPendingSpinner" role="status" aria-hidden="true"></span>
            <i class="fa-solid fa-floppy-disk" id="submitPendingIcon"></i>
            <span class="fw-bold" id="submitPendingLinesBtnText">حفظ أمر الإنتاج</span>
          </button>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- ========================================================================= -->
<!-- Edit Header Modal -->
<!-- ========================================================================= -->
<div class="modal fade" id="editHeaderModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow" style="border-radius: 14px;">
      <div class="modal-header border-bottom py-3">
        <h6 class="modal-title fw-bold text-dark">تعديل بيانات طلب الإنتاج</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <div id="editHeaderAlert" class="alert alert-danger d-none mb-3" role="alert"></div>
        <form id="editHeaderForm">
          <div class="mb-3">
            <label for="editTitleInput" class="form-label fw-bold text-dark">عنوان أمر الإنتاج:</label>
            <input type="text" id="editTitleInput" class="form-control" maxlength="255" required value="<%= order.title %>">
          </div>
          <div class="mb-3">
            <label for="editDescriptionInput" class="form-label fw-bold text-dark">الوصف:</label>
            <textarea id="editDescriptionInput" class="form-control" maxlength="2000" rows="3"></textarea>
          </div>
          <div class="mb-3">
            <label for="editNotesInput" class="form-label fw-bold text-dark">الملاحظات:</label>
            <textarea id="editNotesInput" class="form-control" rows="3" maxlength="2000"></textarea>
          </div>
          <div class="d-flex justify-content-end gap-2 border-top pt-3">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">إلغاء</button>
            <button type="submit" id="confirmEditHeaderBtn" class="btn production-theme-btn btn-sm">حفظ التعديلات</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="/js/production-order-edit.js"></script>
